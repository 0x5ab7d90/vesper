---
export const prerender = true

import Layout from "@/layouts/main.astro"
import { DownloadButton } from "@/components/download-button"
import DropMascot from "@/components/drop-mascot.astro"
import { HeroBackdrop } from "@/components/hero-backdrop"
// Read the current release version from the updater feed at build time so the
// site does not depend on files outside apps/site when deployed on its own.
const RELEASE_FEED =
  "https://pub-92303d062b7f481ea248cd257e2b658c.r2.dev/release/latest.yml"
const version = await fetch(RELEASE_FEED)
  .then((r) => (r.ok ? r.text() : ""))
  .then((t) => t.match(/^version:\s*(.+)$/m)?.[1]?.trim())
  .catch(() => undefined)

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Vesper",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS, Windows",
  softwareVersion: version,
  description:
    "Vesper pulls together movies, shows, and anime in one library with instant cached playback. Free desktop app for Mac and Windows.",
  url: "https://vespr.dev/",
  downloadUrl: "https://vespr.dev/",
  screenshot: "https://vespr.dev/hero.webp",
  featureList:
    "Unified library for movies, TV, and anime. Instant cached playback. Real subtitles with automatic audio-sync. Intro and recap skip on TV shows. Cross-device watch progress. Letterboxd and Trakt import. Discord Rich Presence. Rebindable keyboard shortcuts. OpenDyslexic font toggle.",
  author: {
    "@type": "Organization",
    name: "Vesper",
    url: "https://vespr.dev/",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
}

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Vesper",
  url: "https://vespr.dev/",
}

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Vesper",
  url: "https://vespr.dev/",
  logo: "https://vespr.dev/favicon-192.png",
}
---

<Layout>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(websiteSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />

  <section
    class="mx-auto flex max-w-xl flex-col items-start justify-center px-4 pt-32 pb-0 sm:px-8 sm:pt-40"
  >
    <div class="reveal mb-6 [animation-delay:80ms]">
      <DropMascot class="block size-24" />
    </div>

    <h1
      class="reveal mb-3 text-xl font-bold tracking-tight text-foreground [animation-delay:160ms]"
    >
      One app for everything you watch.
    </h1>

    <p
      class="reveal mb-6 max-w-2xl text-sm text-muted-foreground [animation-delay:240ms]"
    >
      Vesper pulls together movies, shows, and anime in one library with instant
      cached playback. Free for Mac and Windows.
    </p>

    <div class="reveal [animation-delay:320ms]">
      <DownloadButton client:load />
    </div>
  </section>

  <section class="screenshot-demo-section">
    <div class="screenshot-demo reveal [animation-delay:400ms]">
      <figure class="screenshot-demo__frame">
        <HeroBackdrop client:idle />
        <div class="screenshot-demo__app">
          <picture>
            <source srcset="/screenshots/hero-home.avif" type="image/avif" />
            <img
              src="/screenshots/hero-home.png"
              alt="Vesper app, showing the detail page for a movie with friends watching activity on the right"
              width="2000"
              height="1280"
              loading="eager"
              decoding="async"
              draggable="false"
            />
          </picture>
        </div>
      </figure>
    </div>
  </section>

  <style>
    .screenshot-demo-section {
      padding: 48px 16px 96px;
      overflow: hidden;
    }
    .screenshot-demo {
      width: 80%;
      max-width: none;
      margin-inline: auto;
      transform: perspective(2000px) rotateX(2deg);
      transform-origin: 50% 100%;
      transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    .screenshot-demo:hover {
      transform: perspective(2000px) rotateX(0deg);
    }
    /* The padding is the shader: it is the only part of the frame the app window
       does not cover. The sides are deliberately thinner than the top band, at
       0.4x, so the effect reads as a rim rather than a border. */
    .screenshot-demo__frame {
      position: relative;
      margin: 0;
      padding: 3.6% 1.44% 0;
      background: #000;
      border-radius: 28px;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to bottom, #000 10%, transparent 85%);
      mask-image: linear-gradient(to bottom, #000 10%, transparent 85%);
    }
    .screenshot-demo__app {
      position: relative;
      aspect-ratio: 2000 / 1280;
      border-radius: 20px 20px 0 0;
      overflow: hidden;
    }
    .screenshot-demo__app picture,
    .screenshot-demo__app img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center -2px;
      image-rendering: -webkit-optimize-contrast;
      user-select: none;
      -webkit-user-select: none;
      -webkit-user-drag: none;
      -webkit-touch-callout: none;
    }
    /* On narrow screens the frame fills the width, with radii and the tilt
       scaled down to match. The rim padding is a percentage so it shrinks on
       its own. */
    @media (max-width: 820px) {
      .screenshot-demo-section {
        padding: 32px 12px 64px;
      }
      .screenshot-demo {
        width: 100%;
        transform: perspective(1200px) rotateX(1.5deg);
      }
      .screenshot-demo__frame {
        border-radius: 16px;
      }
      .screenshot-demo__app {
        border-radius: 10px 10px 0 0;
      }
    }
    @media (max-width: 480px) {
      .screenshot-demo-section {
        padding: 24px 8px 48px;
      }
      .screenshot-demo__frame {
        border-radius: 12px;
      }
      .screenshot-demo__app {
        border-radius: 8px 8px 0 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .screenshot-demo {
        transform: none;
        transition: none;
      }
    }
  </style>
</Layout>
