---
export const prerender = true

import Layout from "@/layouts/main.astro"
import { DownloadButton } from "@/components/download-button"
import DropMascot from "@/components/drop-mascot.astro"
import { HeroBackdrop } from "@/components/hero-backdrop"
import { HeroApp } from "@/components/hero-app"
import heroDemo from "@/data/hero-demo.json"

// The first featured slide paints on the very first frame, so its images are
// preloaded instead of discovered after hydration.
const first = heroDemo.featured[0]
const preload = [
  `https://image.tmdb.org/t/p/w1280${first.backdrop}`,
  `https://image.tmdb.org/t/p/w780${first.poster}`,
  first.logo,
].filter(Boolean) as string[]
// Read the current release version from the updater feed at build time so the
// site does not depend on files outside apps/site when deployed on its own.
const RELEASE_FEED =
  "https://pub-92303d062b7f481ea248cd257e2b658c.r2.dev/release/latest.yml"
const version = await fetch(RELEASE_FEED)
  .then((r) => (r.ok ? r.text() : ""))
  .then((t) => t.match(/^version:\s*(.+)$/m)?.[1]?.trim())
  .catch(() => undefined)

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Vesper",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS, Windows",
  softwareVersion: version,
  description:
    "Vesper pulls together movies, shows, and anime in one library with instant cached playback. Free desktop app for Mac and Windows.",
  url: "https://vespr.dev/",
  downloadUrl: "https://vespr.dev/",
  screenshot: "https://vespr.dev/hero.webp",
  featureList:
    "Unified library for movies, TV, and anime. Instant cached playback. Real subtitles with automatic audio-sync. Intro and recap skip on TV shows. Cross-device watch progress. Letterboxd and Trakt import. Discord Rich Presence. Rebindable keyboard shortcuts. OpenDyslexic font toggle.",
  author: {
    "@type": "Organization",
    name: "Vesper",
    url: "https://vespr.dev/",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
}

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Vesper",
  url: "https://vespr.dev/",
}

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Vesper",
  url: "https://vespr.dev/",
  logo: "https://vespr.dev/favicon-192.png",
}
---

<Layout>
  {preload.map((href) => <link rel="preload" as="image" href={href} />)}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(websiteSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />

  <section
    class="mx-auto flex max-w-xl flex-col items-start justify-center px-4 pt-32 pb-0 sm:px-8 sm:pt-40"
  >
    <div class="reveal mb-6 [animation-delay:80ms]">
      <DropMascot class="block size-24" />
    </div>

    <h1
      class="reveal mb-3 text-xl font-bold tracking-tight text-foreground [animation-delay:160ms]"
    >
      One app for everything you watch.
    </h1>

    <p
      class="reveal mb-6 max-w-2xl text-sm text-muted-foreground [animation-delay:240ms]"
    >
      Vesper pulls together movies, shows, and anime in one library with instant
      cached playback. Free for Mac and Windows.
    </p>

    <div class="reveal [animation-delay:320ms]">
      <DownloadButton client:load />
    </div>
  </section>

  <section class="screenshot-demo-section">
    <div class="screenshot-demo reveal [animation-delay:400ms]">
      <figure class="screenshot-demo__frame">
        <HeroBackdrop client:load />
        <div class="screenshot-demo__app">
          <HeroApp client:load version={version} />
        </div>
        <div class="screenshot-demo__fade" aria-hidden="true"></div>
      </figure>
    </div>
  </section>

  <script is:inline>
    // The app window is laid out at 1440px and scaled down to the frame. The
    // React island re-measures after hydration; this sets the same value
    // before first paint so the window is never briefly unscaled. It writes to
    // the Astro-owned wrapper, not to the island, so hydration still matches.
    ;(function () {
      var host = document.querySelector(".screenshot-demo__app")
      var outer = host && host.querySelector("[data-hero-app]")
      if (!outer) return
      host.style.setProperty("--ha-scale", outer.clientWidth / 1440)
    })()
  </script>

  <style>
    .screenshot-demo-section {
      padding: 48px 16px 96px;
      overflow: hidden;
    }
    .screenshot-demo {
      width: 80%;
      max-width: none;
      margin-inline: auto;
      transform: perspective(2000px) rotateX(2deg);
      transform-origin: 50% 100%;
      transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    .screenshot-demo:hover {
      transform: perspective(2000px) rotateX(0deg);
    }
    /* The padding is the shader: it is the only part of the frame the app
       window does not cover. */
    .screenshot-demo__frame {
      position: relative;
      margin: 0;
      /* Equal on the top and the sides, so the window's top corners sit on the
         45° diagonal out of the frame's own top corners. Percentage padding
         resolves against width on every side, so that holds at any size. */
      padding: 2.4% 2.4% 0;
      /* Stands in for the shader until its first frame, sampled from where the
         field settles: an indigo crown across the top with a softer bloom down
         the left, so the rim never shows as flat black and the hand-off is
         invisible. */
      background:
        radial-gradient(
          130% 110% at 12% 15%,
          #625dc1 0%,
          #4d43ad 35%,
          #3d2f96 65%,
          #33268a 100%
        )
        #33268a;
      /* Square at the bottom. That edge is fully faded to the page colour, so
         the curve bought nothing, and clipping the bright rim along it left an
         anti-aliased crescent the fade could not cover. */
      border-radius: 26px 26px 0 0;
      overflow: hidden;
    }
    /* The frame fades into the page. A mask on the tilted frame left tile
       seams across the fade, so this is an opaque overlay in the page colour
       instead, eased so the fall-off has no visible steps. */
    .screenshot-demo__fade {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        to bottom,
        rgba(18, 18, 18, 0) 10%,
        rgba(18, 18, 18, 0.013) 17%,
        rgba(18, 18, 18, 0.049) 24%,
        rgba(18, 18, 18, 0.104) 31%,
        rgba(18, 18, 18, 0.175) 38%,
        rgba(18, 18, 18, 0.259) 45%,
        rgba(18, 18, 18, 0.352) 52%,
        rgba(18, 18, 18, 0.45) 59%,
        rgba(18, 18, 18, 0.55) 66%,
        rgba(18, 18, 18, 0.648) 72%,
        rgba(18, 18, 18, 0.741) 77%,
        rgba(18, 18, 18, 0.825) 81%,
        rgba(18, 18, 18, 0.896) 84%,
        rgba(18, 18, 18, 0.951) 87%,
        rgba(18, 18, 18, 0.987) 90%,
        #121212 93%
      );
    }
    /* macOS 26 window. Same radius as the frame, and inset equally on both
       axes, so the two top corners read as one diagonal. */
    .screenshot-demo__app {
      position: relative;
      border-radius: 26px 26px 0 0;
      corner-shape: squircle;
      overflow: hidden;
      background: #000;
    }
    /* On narrow screens the frame fills the width, with radii and the tilt
       scaled down to match. The rim padding is a percentage so it shrinks on
       its own. */
    @media (max-width: 820px) {
      .screenshot-demo-section {
        padding: 32px 12px 64px;
      }
      .screenshot-demo {
        width: 100%;
        transform: perspective(1200px) rotateX(1.5deg);
      }
      .screenshot-demo__frame {
        border-radius: 14px 14px 0 0;
      }
      .screenshot-demo__app {
        border-radius: 14px 14px 0 0;
      }
    }
    @media (max-width: 480px) {
      .screenshot-demo-section {
        padding: 24px 8px 48px;
      }
      .screenshot-demo__frame {
        border-radius: 10px 10px 0 0;
      }
      .screenshot-demo__app {
        border-radius: 10px 10px 0 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .screenshot-demo {
        transform: none;
        transition: none;
      }
    }
  </style>
</Layout>
