{
  "name": "@vesper/desktop",
  "version": "2.26.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "Vesper desktop client",
  "main": "./out/main/index.js",
  "author": {
    "name": "Vesper",
    "email": "hi@vespr.dev"
  },
  "homepage": "https://vespr.dev",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "routes:generate": "tsr generate",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "splash": "VESPER_SPLASH_ONLY=1 electron-vite dev",
    "build": "npm run routes:generate && npm run typecheck && electron-vite build && npm run harden",
    "harden": "node scripts/harden.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac --publish always",
    "dist:mac:nopub": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "dist:win:nopub": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@convex-dev/auth": "^0.0.92",
    "@convex-dev/presence": "^0.3.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@huggingface/transformers": "^4.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@mediabunny/ac3": "^1.45.4",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-persist-client": "^5.100.11",
    "@tanstack/react-router": "^1.170.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "@vesper/changelog": "workspace:^",
    "@xhayper/discord-rpc": "^1.3.4",
    "agentation": "^3.0.2",
    "allotment": "^1.20.5",
    "anime4k-webgpu": "^1.0.0",
    "bytenode": "^1.5.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.20",
    "discord-api-types": "^0.38.47",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.3",
    "lenis": "^1.3.26",
    "liveline": "^0.0.7",
    "mediabunny": "file:../../vendor/mediabunny",
    "motion": "^12.40.0",
    "nucleo-flags": "^1.1.3",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.76.0",
    "tailwind-merge": "^3.6.0",
    "voice-glow": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-cli": "^1.167.6",
    "@tanstack/router-plugin": "^1.168.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@webgpu/types": "^0.1.70",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "javascript-obfuscator": "^5.4.3",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
